AOL/1
ID=CORE.EVIDENCE
LEDGER=projects/<PROJECT>/evidence/ledger.ndjson
FORM=NDJSON+APPEND_ONLY+ONE_RECORD_PER_LINE
FIELD=ID+TS+PROJECT+TASK+ROLE+ACTOR+KIND+CLAIM+VERDICT
ACTOR=ID+MODEL+SESSION+TRUST
TRUST=RUNTIME|DECLARED
TRUST:RUNTIME=STAMPED_BY_HARNESS_NOT_AUTHORED_BY_MODEL
TRUST:DECLARED=SUPPLIED_BY_AGENT+WEAKER
KIND=TEST|REVIEW|ARCH_APPROVAL|DEPLOY|POSTDEPLOY|DEFECT
VERDICT=PASS|FAIL|BLOCKED
REQUIRE:TEST=COMMAND+EXIT_CODE+ARTIFACT
REQUIRE:DEPLOY=COMMAND+EXIT_CODE+ARTIFACT
REQUIRE:POSTDEPLOY=COMMAND+EXIT_CODE+ARTIFACT
REQUIRE:REVIEW=SUBJECT
REQUIRE:ARCH_APPROVAL=SUBJECT
REQUIRE:DEFECT=CLAIM
ARTIFACT=PATH+SHA256+ASSERTIONS
SUBJECT=PATH+SHA256
REJECT=PASS_WITH_NONZERO_EXIT+MISSING_ARTIFACT_PATH+UNKNOWN_ROLE+UNKNOWN_KIND+MISSING_REQUIRED_FIELD
VERIFY=REHASH_ARTIFACTS+REHASH_SUBJECTS+REPORT_DRIFT
MANDATE=EVIDENCE_IS_RECORDED_NOT_ASSERTED
