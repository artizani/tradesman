AOL/1
FLOW=INTAKE>CONTEXT>JOURNEY>ARCH>ARCH_REVIEW>IMPLEMENT>UNIT+COMPONENT+CODE_REVIEW+SECURITY_REVIEW>JOURNEY_TEST>TEST_REVIEW>MERGE>DEPLOY>POSTDEPLOY>STATE>HANDOFF
FAIL=RECORD+CLASSIFY+ROOTCAUSE+ROUTE_DISTINCT_ROLE+RETEST
GATEPAIR=ARCH:ARCH_REVIEW+IMPLEMENT:CODE_REVIEW+UNIT:TEST_REVIEW
REWORK=ON_REVIEW_FAIL>ROUTE_AUTHOR_WITH_FINDINGS>REREVIEW MAX=2 THEN=ESCALATE_HUMAN
SEVERITY=BLOCKING|ADVISORY
BLOCKING=CORRECTNESS+INVARIANT_BREACH+SECURITY+SCOPE_BREACH+MISSING_EVIDENCE+RISK_UNDERDECLARED
ADVISORY=STYLE+NAMING+FUTURE_WORK+PREFERENCE
REVIEW_VERDICT=FAIL_ONLY_ON_BLOCKING+ADVISORY_BECOMES_DEFECT
INCREMENT=RUNNING_TESTED_CODE_NOT_DOCUMENTS
DONE_ONE_SHOT=IMPLEMENTATION+PASSING_TEST_EVIDENCE+INDEPENDENT_REVIEW_PASS
CARRY=PRIOR_HANDOFFS+PRIOR_FINDINGS+FILES_WRITTEN
RISK_ORDER=critical>high>low
FLOW:low=IMPLEMENT>CODE_REVIEW>UNIT
FLOW:high=ARCH>ARCH_REVIEW>IMPLEMENT>CODE_REVIEW>UNIT>TEST_REVIEW
FLOW:critical=ARCH>ARCH_REVIEW>IMPLEMENT>CODE_REVIEW+SECURITY_REVIEW>UNIT+COMPONENT>TEST_REVIEW>JOURNEY_TEST
RISK_FLOOR=DELIVERS_CRIT_JOURNEY>critical|INV_REF>high|ELSE>low
JOURNEY_REF=JOURNEY:DELIVERS_INHERITS_CRIT|SERVES:CONTRIBUTES_NO_FLOOR
RISK_EFFECTIVE=HIGHEST_OF:DECLARED+FLOOR+PATH
RISK_RATCHET=RAISE_ANYTIME+NEVER_LOWER_AFTER_EVIDENCE
ON_RISK_BREACH=DENY_WRITE+RECORD_DEFECT+RESTART_FLOW_AT_PATH_RISK MAX=1 THEN=ESCALATE_HUMAN
