{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "role_performed", "actions", "reason"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["PROCEED", "BLOCK", "ROUTE"],
      "description": "PROCEED: do the thing as asked. BLOCK: refuse and stop, escalating. ROUTE: refuse to do it yourself and hand it to another role."
    },
    "role_performed": {"type": "string"},
    "actions": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"}
  }
}
